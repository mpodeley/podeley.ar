{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://podeley.ar/data/ciber-incidentes.schema.json",
  "title": "Registro de ciberincidentes en energía e infraestructura crítica argentina",
  "description": "Esquema del dataset publicado en https://podeley.ar/data/ciber-incidentes.json. Cada incidente separa lo que declaró la organización de lo que reclamó el atacante; el campo confianza califica la existencia del incidente, no la veracidad del reclamo.",
  "type": "object",
  "required": [
    "titulo",
    "actualizado",
    "licencia",
    "nota_metodo",
    "nota_correcciones",
    "correcciones",
    "campos",
    "incidentes"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "titulo": { "type": "string" },
    "actualizado": { "$ref": "#/$defs/fecha" },
    "licencia": { "type": "string" },
    "nota_metodo": { "type": "string" },
    "nota_correcciones": { "type": "string" },
    "correcciones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fecha", "que_cambio"],
        "additionalProperties": false,
        "properties": {
          "fecha": { "$ref": "#/$defs/fecha" },
          "tipo": {
            "description": "fila = corrección de un incidente; esquema = cambio en la estructura del dataset.",
            "enum": ["fila", "esquema"]
          },
          "fila": {
            "description": "id del incidente corregido, cuando tipo = fila.",
            "type": "string"
          },
          "que_cambio": { "type": "string" },
          "senalado_por": { "type": "string" }
        }
      }
    },
    "campos": {
      "description": "Glosario de campos no evidentes.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "incidentes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/incidente" }
    },
    "actores": {
      "description": "Ficha por grupo nombrado en el registro. El nombre coincide letra por letra con el campo actor de sus incidentes; la disciplina de atribución es la misma que la de las filas: solo lo que sostiene un aviso oficial o un reporte primario, con el estado fechado.",
      "type": "array",
      "items": { "$ref": "#/$defs/actor" }
    },
    "contexto_internacional": {
      "description": "Precedentes extranjeros curados. No es un registro: es una selección de casos de alta confianza que iluminan los hallazgos argentinos.",
      "type": "array",
      "items": { "$ref": "#/$defs/contexto" }
    }
  },
  "$defs": {
    "fecha": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "fechaFlexible": {
      "description": "Fecha con precisión de día o de mes. Los precedentes internacionales a veces solo tienen mes defendible (p. ej. la fecha de un reporte); afirmar un día sería falsa precisión.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
    },
    "fuentes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^https?://" }
    },
    "confianza": { "enum": ["alta", "media", "baja"] },
    "provincia": {
      "enum": [
        "caba", "buenos-aires", "catamarca", "chaco", "chubut", "cordoba",
        "corrientes", "entre-rios", "formosa", "jujuy", "la-pampa", "la-rioja",
        "mendoza", "misiones", "neuquen", "rio-negro", "salta", "san-juan",
        "san-luis", "santa-cruz", "santa-fe", "santiago-del-estero",
        "tierra-del-fuego", "tucuman"
      ]
    },
    "anioMes": {
      "description": "Año, o año y mes, para primeras observaciones y cambios de estado: afirmar un día sería falsa precisión.",
      "type": "string",
      "pattern": "^\\d{4}(-\\d{2})?$"
    },
    "actor": {
      "type": "object",
      "required": ["id", "nombre", "tipo", "observado_desde", "estado", "modus_operandi", "incidentes", "fuentes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "nombre": {
          "description": "Coincide letra por letra con incidentes[].actor: es la clave del cruce.",
          "type": "string"
        },
        "alias": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tipo": {
          "description": "raas = plataforma con afiliados; ransomware = grupo cerrado o sin clasificación pública, dicho en la nota.",
          "enum": ["ransomware", "raas"]
        },
        "observado_desde": { "$ref": "#/$defs/anioMes" },
        "estado": {
          "description": "Al cierre de la fecha del campo actualizado. interrumpido = infraestructura incautada o detenciones; inactivo = sin actividad reportada, sin acción policial conocida; renombrado = sigue operando bajo otra marca, dicho en la nota.",
          "enum": ["activo", "interrumpido", "inactivo", "renombrado"]
        },
        "estado_desde": { "$ref": "#/$defs/anioMes" },
        "modus_operandi": { "type": "string" },
        "nota": { "type": "string" },
        "incidentes": {
          "description": "ids de las filas de este registro que nombran al grupo.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "contexto": {
          "description": "ids de casos de contexto_internacional del mismo grupo.",
          "type": "array",
          "items": { "type": "string" }
        },
        "fuentes": { "$ref": "#/$defs/fuentes" }
      }
    },
    "incidente": {
      "type": "object",
      "required": [
        "id",
        "org",
        "subsector",
        "provincias",
        "fecha_incidente",
        "fecha_publica",
        "canal_divulgacion",
        "actor",
        "actor_tipo",
        "sistemas_segun_empresa",
        "sistemas_segun_actor",
        "datos_publicados",
        "impacto_operativo_declarado",
        "confianza",
        "fuentes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+-\\d{4}-\\d{2}$" },
        "org": { "type": "string" },
        "subsector": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "provincias": {
          "description": "Jurisdicciones del incidente; la primera es el ancla del mapa: la sede de los sistemas afectados (casi siempre administrativos), no la huella comercial. Investigado a mano; el criterio y sus límites van en ubicacion_nota cuando el ancla no es obvia.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provincia" }
        },
        "ubicacion_nota": { "type": "string" },
        "fecha_incidente": { "$ref": "#/$defs/fecha" },
        "fecha_publica": { "$ref": "#/$defs/fecha" },
        "fecha_divulgacion_empresa": { "$ref": "#/$defs/fecha" },
        "canal_divulgacion": {
          "anyOf": [
            { "enum": ["prensa", "leak-site", "cnv", "organismo"] },
            { "type": "string", "pattern": "^leak-site, luego (cnv|prensa|organismo)$" }
          ]
        },
        "actor": { "type": "string" },
        "actor_tipo": { "enum": ["ransomware", "raas", "desconocido"] },
        "sistemas_segun_empresa": { "type": ["string", "null"] },
        "sistemas_segun_actor": { "type": ["string", "null"] },
        "datos_publicados": { "enum": ["si", "no", "sin confirmar"] },
        "impacto_operativo_declarado": { "type": ["string", "null"] },
        "vector_reportado": { "type": "string" },
        "confianza": { "$ref": "#/$defs/confianza" },
        "confianza_atribucion": { "$ref": "#/$defs/confianza" },
        "nota": { "type": "string" },
        "fuentes": { "$ref": "#/$defs/fuentes" }
      }
    },
    "contexto": {
      "type": "object",
      "required": [
        "id",
        "org",
        "pais",
        "region",
        "subsector",
        "fecha_publica",
        "actor",
        "actor_tipo",
        "capa_afectada",
        "nota",
        "fuentes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+-\\d{4}-\\d{2}$" },
        "org": { "type": "string" },
        "pais": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "region": { "enum": ["latam", "global"] },
        "subsector": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "fecha_incidente": { "$ref": "#/$defs/fechaFlexible" },
        "fecha_publica": { "$ref": "#/$defs/fechaFlexible" },
        "actor": { "type": "string" },
        "actor_tipo": { "enum": ["ransomware", "raas", "estatal", "desconocido"] },
        "capa_afectada": {
          "description": "Dónde pegó el ataque. La columna existe para mapear cada precedente a los hallazgos argentinos: la capa comercial que programa el flujo físico es distinta de la IT corporativa y del control industrial.",
          "enum": [
            "it-corporativa",
            "capa-comercial-despacho",
            "ot-control-industrial",
            "sis-seguridad-instrumentada"
          ]
        },
        "nota": { "type": "string" },
        "fuentes": { "$ref": "#/$defs/fuentes" }
      }
    }
  }
}
